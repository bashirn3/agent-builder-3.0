# K1 Agent Builder
# Direct Supabase mode is used only when both Supabase values are present.
# The anon key must be protected by Supabase Auth + RLS policies.
VITE_K1_SUPABASE_URL=
VITE_K1_SUPABASE_ANON_KEY=
VITE_K1_SUPABASE_DIRECT_ENABLED=false

# Optional n8n proxy/test mode.
# Use this if Supabase Auth/RLS is not ready, or for prompt-only tester calls.
VITE_N8N_BUILDER_BASE_URL=
VITE_N8N_BUILDER_PUBLIC_TOKEN=
